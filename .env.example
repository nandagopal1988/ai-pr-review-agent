# Environment variables for Code Review Agent

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_REPOSITORY=owner/repo

# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, anthropic
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=your_anthropic_api_key

# SonarQube Configuration (Optional)
SONARQUBE_ENABLED=true
SONARQUBE_HOST_URL=https://sonarqube.example.com
SONARQUBE_TOKEN=your_sonarqube_token
SONARQUBE_PROJECT_KEY=com.example:code-review-agent

# Code Coverage Configuration
COVERAGE_MINIMUM=80
COVERAGE_REPORT_PATH=coverage/lcov.info

# Logging Configuration
LOG_LEVEL=info  # Options: debug, info, warn, error
DEBUG=false

# Review Configuration
REVIEW_ON_DRAFT_PR=false
BLOCK_ON_CRITICAL_ISSUES=true
AUTO_COMMIT_SUGGESTIONS=false

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_TOKENS_PER_MINUTE=90000

# Webhook Configuration (Optional)
WEBHOOK_URL=
WEBHOOK_SECRET=
